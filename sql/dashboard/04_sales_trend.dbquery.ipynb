   "source": [
    "\n",
    "SELECT\n",
    "    DATE(order_timestamp) AS order_date,\n",
    "    COUNT(DISTINCT order_id) AS total_orders,\n",
    "    ROUND(SUM(quantity * price),2) AS daily_revenue\n",
    "\n",
    "FROM dbr_dev.brazilian_ecommerce_bronze.brz_orders\n",
    "\n",
    "GROUP BY DATE(order_timestamp)\n",
    "\n",
    "ORDER BY order_date;"
